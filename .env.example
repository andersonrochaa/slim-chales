# Copie para .env e preencha. Na Vercel, cadastre as mesmas variáveis em Settings > Environment Variables.

# Resend (https://resend.com/api-keys)
RESEND_API_KEY=
# Quem recebe os pedidos de orçamento (pode ser mais de um, separados por vírgula)
CONTACT_TO_EMAIL=
# Remetente num domínio verificado no Resend, ex.: Slim Chalés <orcamento@seudominio.com.br>
CONTACT_FROM_EMAIL=

# Cloudflare Turnstile (opcional). Deixe as duas em branco para desligar.
TURNSTILE_SECRET_KEY=
PUBLIC_TURNSTILE_SITE_KEY=

# URL pública do site, com https (canonical, Open Graph, sitemap e dados estruturados).
# Na Vercel, se ficar vazia, usa o domínio de produção da Vercel. Ex.: https://www.slimchales.com.br
SITE_URL=

# Google Search Console: código da meta tag de verificação (só o valor de content). Opcional.
PUBLIC_GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools: valor de content da meta msvalidate.01. Opcional.
PUBLIC_BING_SITE_VERIFICATION=
