---
import { PUBLIC_BING_SITE_VERIFICATION, PUBLIC_GOOGLE_SITE_VERIFICATION } from 'astro:env/client';
import '@fontsource/barlow-condensed/600.css';
import '@fontsource/barlow-condensed/700.css';
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/600.css';
import barlow700 from '@fontsource/barlow-condensed/files/barlow-condensed-latin-700-normal.woff2?url';
import plex400 from '@fontsource/ibm-plex-sans/files/ibm-plex-sans-latin-400-normal.woff2?url';
import '../styles/global.css';
import { empresa } from '../data/conteudo';
import { fotosKit, imagensParaBusca } from '../data/imagens';
import { comBase, raizDoSite, versaoDeTeste } from '../lib/site';

interface Props {
  title: string;
  description: string;
  /** Título para WhatsApp, Facebook, LinkedIn e X. Se faltar, usa o title. */
  tituloSocial?: string;
  /** Páginas que não devem aparecer no Google (ex.: confirmação de envio). */
  noindex?: boolean;
}

const { title, description, tituloSocial = title, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
// Imagem de compartilhamento: 1200 x 630 (proporção 1,91:1), em JPEG para funcionar em todo app.
const { compartilhamento } = await imagensParaBusca(raizDoSite(Astro.site!));
const ogUrl = new URL(compartilhamento.url);
const ogAlt = fotosKit.rio.alt;
const robots = noindex || versaoDeTeste
  ? 'noindex, follow'
  : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={robots} />
    <meta name="author" content={empresa.nome} />

    <link rel="preload" href={barlow700} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={plex400} as="font" type="font/woff2" crossorigin />

    <!-- Ícones: .ico com 16, 32 e 48 px e PNG de 96 px (o Google pede múltiplos de 48), SVG para navegadores novos -->
    <link rel="icon" href={comBase('/favicon.ico')} sizes="any" />
    <link rel="icon" href={comBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={comBase('/favicon-96x96.png')} type="image/png" sizes="96x96" />
    <link rel="apple-touch-icon" href={comBase('/apple-touch-icon.png')} />
    <link rel="manifest" href={comBase('/site.webmanifest')} />
    <meta name="theme-color" content="#0b0b0b" />
    <meta name="color-scheme" content="dark" />
    <meta name="application-name" content={empresa.nome} />
    <meta name="apple-mobile-web-app-title" content={empresa.nome} />
    <link rel="sitemap" type="application/xml" href={comBase('/sitemap.xml')} />

    <!-- Compartilhamento (WhatsApp, Facebook, Instagram, LinkedIn) -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={empresa.nome} />
    <meta property="og:title" content={tituloSocial} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    {ogUrl.protocol === 'https:' && <meta property="og:image:secure_url" content={ogUrl} />}
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />

    <!-- X (Twitter) -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={tituloSocial} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />
    <meta name="twitter:image:alt" content={ogAlt} />

    {PUBLIC_GOOGLE_SITE_VERIFICATION && <meta name="google-site-verification" content={PUBLIC_GOOGLE_SITE_VERIFICATION} />}
    {PUBLIC_BING_SITE_VERIFICATION && <meta name="msvalidate.01" content={PUBLIC_BING_SITE_VERIFICATION} />}

    <slot name="head" />
  </head>
  <body class="font-sans text-base leading-relaxed antialiased">
    <a
      href="#conteudo"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded-sm focus:bg-laranja focus:px-4 focus:py-2 focus:text-sobre-laranja"
      >Pular para o conteúdo</a
    >
    <slot />
  </body>
</html>
