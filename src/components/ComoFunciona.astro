---
import { passos } from '../data/conteudo';
---

<section id="como-funciona" aria-labelledby="titulo-como-funciona" class="border-t border-linha bg-fundo-2 py-16 md:py-28">
  <div class="container-site">
    <h2 id="titulo-como-funciona" class="text-5xl leading-[0.95] font-bold lg:text-[4rem]">Como funciona</h2>

    <!-- Colunas encostadas: as bordas de cima formam uma linha só, com o passo 1 em laranja. -->
    <ol class="mt-10 grid gap-y-10 sm:grid-cols-2 lg:mt-12 lg:grid-cols-4">
      {
        passos.map((p, i) => (
          <li class:list={['border-t-2 pt-6 sm:pr-8', i === 0 ? 'border-laranja' : 'border-linha-forte']}>
            <p class:list={['rotulo', i === 0 && 'text-laranja']}>Passo {i + 1}</p>
            <h3 class="mt-3 font-sans text-xl leading-snug font-semibold normal-case">{p.titulo}</h3>
            <p class="mt-3 text-texto-3">{p.texto}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
