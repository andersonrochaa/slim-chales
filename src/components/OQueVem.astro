---
import { itensDoKit } from '../data/conteudo';
---

<section id="o-que-vem" aria-labelledby="titulo-o-que-vem" class="border-t border-linha py-16 md:py-28">
  <div class="container-site grid gap-10 lg:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] lg:gap-16">
    <header>
      <h2 id="titulo-o-que-vem" class="text-5xl leading-[0.95] font-bold lg:text-[4rem]">
        O que vem <br class="hidden lg:inline" />no kit
      </h2>
      <p class="mt-4 text-lg text-texto-2">Veja o que acompanha cada kit.</p>
    </header>

    <ol class="border-t border-linha">
      {
        itensDoKit.map((item, i) => (
          <li class="grid grid-cols-[3.25rem_minmax(0,1fr)] border-b border-linha py-7 sm:grid-cols-[5rem_minmax(0,1fr)]">
            <span class="font-display text-2xl leading-tight font-semibold text-laranja" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <div>
              <h3 class="font-sans text-xl leading-snug font-semibold normal-case">{item.titulo}</h3>
              <p class="mt-1 text-texto-3">{item.texto}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
