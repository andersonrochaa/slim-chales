---
import { Image } from 'astro:assets';
import Foto from './Foto.astro';
import { kits } from '../data/conteudo';
import { fotosKit as imagens } from '../data/imagens';
---

<section id="kits" aria-labelledby="titulo-kits" class="border-t border-linha bg-fundo-2 py-16 md:py-28">
  <div class="container-site">
    <header class="flex flex-wrap items-end justify-between gap-x-10 gap-y-5">
      <h2 id="titulo-kits" class="text-5xl leading-[0.95] font-bold lg:text-[4rem]">
        Qual kit combina <br class="hidden sm:inline" />com <span class="text-laranja">você?</span>
      </h2>
      <p class="max-w-[23rem] text-lg text-texto-2 lg:mr-10">Os dois kits têm a mesma proposta. O que muda é o tamanho.</p>
    </header>

    <div class="mt-12 grid gap-20 md:mt-16 lg:grid-cols-2 lg:gap-10">
      {
        kits.map((kit) => (
          <article id={`kit-${kit.id}`} aria-labelledby={`titulo-${kit.id}`} class="flex flex-col">
            <Foto
              src={imagens[kit.id].foto}
              alt={imagens[kit.id].alt}
              widths={[400, 560, 720, 900, 1200]}
              sizes="(min-width: 1320px) 600px, (min-width: 1024px) 46vw, calc(100vw - 2rem)"
              class="aspect-[4/3] w-full rounded-sm object-cover"
            />

            <div class="mt-7 flex items-end justify-between gap-4 border-b border-linha pb-5">
              <h3 id={`titulo-${kit.id}`} class="text-5xl leading-none font-bold">
                Kit <span class="text-laranja">{kit.destaque}</span>
              </h3>
              <p class="font-display text-4xl leading-none font-semibold whitespace-nowrap">{kit.area}</p>
            </div>

            <div class="mt-7 grid grow grid-cols-[minmax(0,1fr)_minmax(0,1.85fr)] gap-x-5 sm:gap-x-7">
              <figure class="self-start">
                <Image
                  src={imagens[kit.id].planta}
                  alt={`Planta baixa do ${kit.nome}: ${kit.especificacoes.map(([r, v]) => `${r.toLowerCase()} ${v.toLowerCase()}`).join(', ')}`}
                  widths={[200, 300, 400]}
                  sizes="(min-width: 1024px) 200px, 30vw"
                  quality={80}
                  class="w-full rounded-sm"
                />
                <figcaption class="mt-3 text-sm text-texto-3">Planta de {kit.planta}</figcaption>
              </figure>

              <div class="flex flex-col">
                <p class="text-texto-2">{kit.chamada}</p>
                <dl class="mt-3 text-[0.9375rem]">
                  {kit.especificacoes.map(([rotulo, valor]) => (
                    <div class="flex justify-between gap-3 border-t border-linha py-3 last:border-b">
                      <dt class="text-texto-3">{rotulo}</dt>
                      <dd class="text-right font-semibold">{valor}</dd>
                    </div>
                  ))}
                </dl>
                <div class="mt-auto flex flex-wrap items-center justify-between gap-x-4 gap-y-3 pt-7">
                  <p class="text-texto-3">
                    Kit por <span class="ml-0.5 text-2xl font-semibold whitespace-nowrap text-texto">{kit.preco}</span>
                  </p>
                  <a href="#contato" data-kit={kit.nome} class="btn btn-primario">
                    Orçar {kit.nome}
                  </a>
                </div>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
